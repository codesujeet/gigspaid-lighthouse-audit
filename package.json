{
  "name": "gigspaid-lighthouse-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Lighthouse mobile audit of gigspaid.com and gigspaid.com/#/work with the top 5 fixes",
  "scripts": {
    "audit": "npm run audit:home && npm run audit:work",
    "audit:home": "lighthouse https://gigspaid.com/ --form-factor=mobile --only-categories=performance,accessibility,best-practices,seo --output=html --output=json --output-path=reports/home --chrome-flags=--headless=new --quiet",
    "audit:work": "lighthouse https://gigspaid.com/#/work --form-factor=mobile --only-categories=performance,accessibility,best-practices,seo --output=html --output=json --output-path=reports/work --chrome-flags=--headless=new --quiet"
  },
  "license": "ISC",
  "devDependencies": {
    "lighthouse": "^12.8.2"
  }
}
